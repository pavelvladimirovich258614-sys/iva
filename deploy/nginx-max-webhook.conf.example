# Пример reverse proxy для webhook MAX. Публикуется ТОЛЬКО путь /max/webhook → локальный мост.
# Eve (iva.service) слушает 127.0.0.1 и наружу не публикуется: его session/stream/reset/status
# маршруты не должны быть доступны из интернета.
#
# MAX требует HTTPS на порту 443 и валидную полную цепочку сертификатов (например, Let's Encrypt).
server {
    listen 443 ssl http2;
    server_name iva.example.com;

    ssl_certificate     /etc/letsencrypt/live/iva.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/iva.example.com/privkey.pem;

    # Всё, кроме webhook-пути, — 404.
    location / { return 404; }

    location = /max/webhook {
        limit_except POST { deny all; }
        client_max_body_size 300k;           # мост сам режет тело на 256 КБ
        proxy_pass http://127.0.0.1:8725/max/webhook;   # MAX_BRIDGE_PORT
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Заголовок X-Max-Bot-Api-Secret передаётся как есть и проверяется мостом.
        proxy_read_timeout 25s;              # MAX ждёт 200 до 30 секунд
    }
}
