# systemd USER unit — MAX polling-мост (GET /updates → локальный канал агента + управление /menu,/model…).
#
# Нужен, когда MAX подключён без публичного HTTPS (по умолчанию). Если вы настроили webhook
# MAX (MAX_INGEST=webhook), этот сервис не запускается.
# Плейсхолдеры __PROJECT_DIR__/__NODE_BIN__ подставляет `iva _install-units`.
[Unit]
Description=Iva MAX polling bridge (GET /updates → local agent channel)
After=network-online.target iva.service
Wants=iva.service

[Service]
# Everything these units create (vault, transcripts, data/) must not be world-readable.
UMask=0077
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=__PROJECT_DIR__/.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=__NODE_BIN__ --env-file=.env scripts/max-bridge.mjs
# Bootstrap units introduced by an update (see iva-telegram-poll.service for the reasoning).
ExecStartPost=-/usr/bin/systemctl --user enable --now iva-update-check.timer
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
